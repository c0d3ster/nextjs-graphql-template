# FIXME: Configure environment variables for your project

# If you need to build a SaaS application with Stripe subscription payment with checkout page, customer portal, webhook, etc.
# You can check out the Next.js Boilerplate SaaS: https://nextjs-boilerplate.com/pro-saas-starter-kit

# #region @module:auth+clerk
# Clerk authentication
# Get your keys from https://clerk.com → Dashboard → API Keys
# Add these to your .env.local (never commit secret keys)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# #endregion @module:auth+clerk
# #region @module:auth+supabase
# Supabase
# Local: run `pnpm run db:start` (needs Docker), then copy the keys from `pnpm exec supabase status`
# Hosted: https://supabase.com → Dashboard → Project Settings → API Keys (see docs/SETUP.md)
# Add these to your .env.local (never commit the secret key)
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SECRET_KEY=sb_secret_...
# #endregion @module:auth+supabase
# #region @module:database+supabase
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# #endregion @module:database+supabase

# #region @module:payments
# Stripe (test mode). Get keys from https://dashboard.stripe.com/test/apikeys
# Add these to your .env.local (never commit secret keys)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_... (printed by `stripe listen`, see README)
# #endregion @module:payments

# Next.js
NEXT_TELEMETRY_DISABLED=1
